#!/bin/bash
# يعرض ما ينتظر في صندوق أدوات Do Kits، ويجهّز طلبَ الفحص في الحافظة.
#
# لماذا لا يستدعي claude مباشرةً: لا CLI على هذا الجهاز — المالك يستعمل تطبيقَ
# سطح المكتب. فالسكربتُ يقرأ الحالةَ وينسخ الطلبَ، ويفتح التطبيقَ إن طُلب.
set -uo pipefail

NAS=root@192.168.70.7
STATE=/mnt/user/personal/dokits-inbox/.inbox-state/INBOX.json
SCAN=/mnt/user/appdata/scripts/dokits-inbox-scan.sh

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
dim()  { printf '\033[2m%s\033[0m\n' "$1"; }

# --scan يجبر تفتيشاً جديداً بدل قراءة آخر جرد
if [ "${1:-}" = "--scan" ] || [ "${1:-}" = "-s" ]; then
  dim "جارٍ التفتيش على الخادم…"
  ssh -o ConnectTimeout=10 "$NAS" "$SCAN" >/dev/null 2>&1
fi

json=$(ssh -o ConnectTimeout=10 "$NAS" "cat $STATE" 2>/dev/null)
if [ -z "$json" ]; then
  printf '\033[31m%s\033[0m\n' "تعذّر الوصول إلى الخادم أو لا جرد بعد."
  echo "جرّب:  ssh $NAS '$SCAN'"
  exit 1
fi

pending=$(printf '%s' "$json" | sed -n 's/.*"pending":\([0-9]*\).*/\1/p')
scanned=$(printf '%s' "$json" | sed -n 's/.*"scannedAt":\([0-9]*\).*/\1/p')
age=$(( ($(date +%s) - ${scanned:-0}) / 60 ))

echo
bold "🧰 صندوق أدوات Do Kits"
dim "آخر تفتيش: قبل ${age} دقيقة"
echo

if [ "${pending:-0}" -eq 0 ]; then
  echo "الصندوق فارغ — لا شيء ينتظر الدمج."
  echo
  dim "ضع أدواتك في:  smb://192.168.70.7/personal → dokits-inbox → جديد"
  exit 0
fi

echo "ينتظر الدمج: ${pending}"
echo
# أسماءُ العناصر وملاحظاتُها من الجرد
printf '%s' "$json" \
  | tr '{' '\n' \
  | sed -n 's/.*"name":"\([^"]*\)".*"files":\([0-9]*\).*"note":"\([^"]*\)".*/  · \1  (\2 ملف)\n    \3/p' \
  | sed 's/^    $//'
echo

ASK="افحص صندوق أدوات Do Kits وادمج ما فيه — اتبع /inbox"
if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$ASK" | pbcopy
  bold "نُسخ الطلب إلى الحافظة."
fi
dim "افتح جلسة Do Kits واكتب:  /inbox"
dim "أو الصق الطلب المنسوخ."
echo

if [ "${1:-}" = "--open" ] || [ "${2:-}" = "--open" ]; then
  open -a Claude 2>/dev/null && dim "فُتح تطبيق Claude."
fi
